digraph Vesper {
  graph [rankdir=LR, bgcolor="#f5f8fc", labelloc=t, label="Scene compilation and ownership", pad=.25, nodesep=.28, ranksep=.60, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", color="#8ca7b7", fillcolor="#e4eef4", fontname="Helvetica", fontsize=11, margin=".13,.09"];
  edge [color="#466270", fontcolor="#334b57", fontname="Helvetica", fontsize=9];
  "Scene v1" -> "Parser" [label="named references"];
  "OBJ and grid bytes" -> "Parser" [label="relative paths"];
  "Parser" -> "Owned scene arrays" [label="validated records"];
  "Owned scene arrays" -> "Binned SAH" [label="swept bounds"];
  "Owned scene arrays" -> "Explicit and area lights" [label="resolve emitters"];
  "Binned SAH" -> "Compiled identity" [label="validate tree"];
  "Explicit and area lights" -> "Compiled identity" [label="canonical fields"];
}
