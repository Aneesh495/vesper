digraph Vesper {
  graph [rankdir=LR, bgcolor="#f5f8fc", labelloc=t, label="Film accumulation and outputs", pad=.25, nodesep=.28, ranksep=.60, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", color="#8ca7b7", fillcolor="#e4eef4", fontname="Helvetica", fontsize=11, margin=".13,.09"];
  edge [color="#466270", fontcolor="#334b57", fontname="Helvetica", fontsize=9];
  "Spectral event" -> "Observer XYZ" [label="XYZ bar at sampled nm"];
  "Spectral event" -> "Spectral band sums" [label="unweighted sensor bands"];
  "Observer XYZ" -> "Welford mean and M2" [label="one update per sample"];
  "Observer XYZ" -> "Temporal XYZ sums" [label="timed energy only"];
  "Temporal XYZ sums" -> "Time gate and excluded energy" [label="reconcile steady Y"];
  "Welford mean and M2" -> "EXR and display" [label="separate transforms"];
}
