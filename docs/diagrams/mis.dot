digraph Vesper {
  graph [rankdir=LR, bgcolor="#f5f8fc", labelloc=t, label="Two densities in solid angle", pad=.25, nodesep=.28, ranksep=.60, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", color="#8ca7b7", fillcolor="#e4eef4", fontname="Helvetica", fontsize=11, margin=".13,.09"];
  edge [color="#466270", fontcolor="#334b57", fontname="Helvetica", fontsize=9];
  "Choose emitter" -> "Sample surface point" [label="1 / light count"];
  "Sample surface point" -> "Light direction PDF" [label="distance squared / cosine"];
  "BSDF sample" -> "BSDF direction PDF" [label="solid angle"];
  "Light direction PDF" -> "Power heuristic" [label="same measure"];
  "BSDF direction PDF" -> "Power heuristic" [label="same measure"];
  "Point or distant light" -> "Unit MIS weight" [label="discrete sample"];
}
