digraph Vesper {
  graph [rankdir=LR, bgcolor="#f5f8fc", labelloc=t, label="Build and device profiles", pad=.25, nodesep=.28, ranksep=.60, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", color="#8ca7b7", fillcolor="#e4eef4", fontname="Helvetica", fontsize=11, margin=".13,.09"];
  edge [color="#466270", fontcolor="#334b57", fontname="Helvetica", fontsize=9];
  "C17 compiler" -> "CPU library" [label="portable reference"];
  "Original GLSL" -> "SPIR-V" [label="glslang"];
  "SPIR-V" -> "Vulkan backend" [label="embedded bytes"];
  "CPU library" -> "CLI and API" [label="CPU option"];
  "Vulkan backend" -> "CLI and API" [label="explicit backend"];
  "Vulkan backend" -> "Hardware" [label="float32 compute"];
  "SDL2" -> "Native workbench" [label="window and input"];
  "CI" -> "CPU plus compile checks" [label="Linux"];
}
