#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=64) in;
#include "layout.glsl"
#include "geometry.glsl"
#include "scatter.glsl"
#include "volume.glsl"
#include "texture.glsl"

float mis(float a,float b) { float r=b/a; return 1./(1.+r*r); }
uint offset_of(uint slot) { return slot*(2u*pc.depth+1u)+2u*pc.iteration; }

float area(Primitive p) {
    return p.info.x==0u?4.*PI*p.a.w*p.a.w:.5*length(cross(p.b.xyz-p.a.xyz,p.c.xyz-p.a.xyz));
}

float area_pdf(Primitive p,vec3 wi,vec3 n,float distance) {
    float cosine=-dot(wi,n);
    return cosine>0.?distance*distance/(cosine*area(p)*float(scene.counts.z)):0.;
}

float index_at(uvec4 stack[4],uint n,float nm,bool group) {
    while (n>0u) {
        Material m=materials[primitives[stack[n/4][n%4]].info.y];
        if (m.info.x!=3u) {
            float um=nm*.001;
            return m.optics.y+(group?3.:1.)*m.optics.z/(um*um);
        }
        --n;
    }
    return 1.;
}

uint medium_at(uvec4 stack[4],uint n) {
    return n==0u?scene.media.x:materials[primitives[stack[n/4][n%4]].info.y].info.w;
}

bool cross_at(inout uvec4 stack[4],inout uint n,uint primitive,bool front) {
    uint id=primitives[primitive].info.z;
    if (front) {
        if (n>=15u || id==0u) { fault(4u); return false; }
        for (uint i=1u;i<=n;++i)
            if (primitives[stack[i/4][i%4]].info.z==id) { fault(5u); return false; }
        ++n;
        stack[n/4][n%4]=primitive;
    } else {
        if (n==0u || primitives[stack[n/4][n%4]].info.z!=id) { fault(6u); return false; }
        --n;
    }
    return true;
}

void contribution(uint slot,uint extra,float value,float time_ns,vec2 pulse) {
    if (!finite1(value) || value<0. || !finite1(time_ns)) { fault(2u); return; }
    if (value>0.) events[offset_of(slot)+extra]=vec4(value,time_ns,pulse);
}

void generate(uint slot) {
    uvec2 k=work[slot];
    vec2 image=vec2(pc.width,pc.height);
    vec2 xy=(2.*(vec2(k.x%pc.width,k.x/pc.width)+vec2(sample_at(k,0),sample_at(k,1)))/image-1.)*
        vec2(image.x/image.y,-1.)*scene.forward.w;
    vec3 axis=scene.forward.xyz+xy.x*scene.right.xyz+xy.y*scene.up.xyz;
    float r=scene.eye.w*sqrt(sample_at(k,2)),phi=2.*PI*sample_at(k,3);
    vec3 lens=r*(scene.right.xyz*cos(phi)+scene.up.xyz*sin(phi));
    vec3 o=scene.eye.xyz+lens,d=normalize(axis*scene.right.w-lens);
    vec2 w=wavelength(sample_at(k,5));
    State s;
    s.origin_time=vec4(o,mix(scene.shutter.x,scene.shutter.y,sample_at(k,4)));
    s.dir_beta=vec4(d,1./w.y);
    s.point_delay=vec4(o,0);
    s.previous_pdf=vec4(o,0);
    s.spectral=vec4(w,1.,1.);
    s.key=uvec4(k,0,0);
    s.tracking=uvec4(0);
    for (uint i=0;i<4;++i) s.boundary[i]=uvec4(0);
    paths[slot]=s;
    queue[slot]=slot;
}

void intersect_path(uint slot) {
    State s=paths[slot];
    for (;s.tracking.x<128u;) {
        Ray ray=Ray(s.origin_time.xyz,s.dir_beta.xyz,0.,FAR,s.origin_time.w);
        Hit h=traverse(ray);
        atomicAdd(counter[3],1u);
        uint medium=medium_at(s.boundary,s.key.w);
        uint dim=0x40000000u+s.tracking.x*2u*TRACK_LIMIT;
        ++s.tracking.x;
        float t,albedo,nm=s.spectral.x;
        bool collided=collision_at(media[medium],ray,h.normal_t.w,nm,s.key.xy,dim,t,albedo);
        if (h.id.x==NONE && !collided) { hits[slot]=h; paths[slot]=s; return; }
        vec3 point;
        if (collided) point=ray.o+ray.d*t;
        else {
            Primitive p=primitives[h.id.x];
            point=surface_point(p,ray,h.normal_t);
        }
        float ng=index_at(s.boundary,s.key.w,nm,true);
        s.point_delay.w+=length(point-s.point_delay.xyz)*ng/C_M_PER_NS;
        s.point_delay.xyz=point;
        if (collided) {
            hits[slot]=Hit(vec4(albedo,media[medium].optics.x,0.,t),uvec4(NONE,1,0,0));
            paths[slot]=s;
            return;
        }
        if (materials[primitives[h.id.x].info.y].info.x!=3u) {
            hits[slot]=h; paths[slot]=s; return;
        }
        if (!cross_at(s.boundary,s.key.w,h.id.x,dot(ray.d,h.normal_t.xyz)<0.)) return;
        s.origin_time.xyz=offset_surface(primitives[h.id.x],point,h.normal_t.xyz,ray.d);
    }
    fault(12u);
}

struct Connection { vec3 wi,endpoint; float dist,le,pdf; bool delta; vec2 pulse; };

float environment_radiance(Light light,float base,vec3 direction) {
    return light.pulse.z>0. && dot(direction,normalize(light.vector.xyz))>=light.vector.w?base+light.pulse.z:base;
}

float environment_integral(Light light,float base) {
    return 4.*PI*base+2.*PI*(1.-light.vector.w)*light.pulse.z;
}

Connection connect_light(vec3 from,float time,float nm,uint index,vec2 u) {
    Light l=lights[index];
    Connection c=Connection(vec3(0),vec3(0),FAR,spectrum(l.power,l.info.y,nm),1./float(scene.counts.z),false,l.pulse.xy);
    if (l.info.x==3u) {
        if (l.pulse.z==0.) {
            c.wi=direction_at(vec3(0,0,1),2.*u.x-1.,2.*PI*u.y);
            c.pdf/=4.*PI;
            return c;
        }
        float integral=environment_integral(l,c.le);
        float cap=2.*PI*(1.-l.vector.w)*l.pulse.z/integral;
        c.wi=u.x<cap?direction_at(normalize(l.vector.xyz),1.-(1.-l.vector.w)*u.x/cap,2.*PI*u.y):
            direction_at(vec3(0,0,1),2.*(u.x-cap)/(1.-cap)-1.,2.*PI*u.y);
        c.le=environment_radiance(l,c.le,c.wi);
        c.pdf*=c.le/integral;
        return c;
    }
    if (l.info.x==1u) { c.wi=normalize(l.vector.xyz); c.delta=true; return c; }
    vec3 endpoint=l.vector.xyz,n=vec3(0);
    if (l.info.x==2u) {
        Primitive p=primitives[l.info.z];
        if (p.info.x==0u) {
            n=direction_at(vec3(0,0,1),2.*u.x-1.,2.*PI*u.y);
            endpoint=p.a.xyz+p.a.w*n;
        } else {
            float r=sqrt(u.x);
            endpoint=(1.-r)*p.a.xyz+r*(1.-u.y)*p.b.xyz+r*u.y*p.c.xyz;
            n=normalize(cross(p.b.xyz-p.a.xyz,p.c.xyz-p.a.xyz));
        }
        endpoint+=p.velocity.xyz*time;
        c.dist=length(endpoint-from);
        if (c.dist<=1e-7) { c.pdf=0.; return c; }
        c.wi=(endpoint-from)/c.dist;
        c.pdf=area_pdf(p,c.wi,n,c.dist);
    } else {
        c.dist=length(endpoint-from);
        if (c.dist<=1e-7) { c.pdf=0.; return c; }
        c.wi=(endpoint-from)/c.dist;
        c.le/=c.dist*c.dist;
        c.delta=true;
    }
    c.endpoint=endpoint;
    return c;
}

void direct_light(uint slot,State s,Material m,vec3 n,vec3 ns,vec3 wo,float ni,float nt,
                  uvec4 next_stack[4],uint next,uint dim,bool volume,float g,uint primitive) {
    if (scene.counts.z==0u) return;
    uvec2 key=s.key.xy;
    uint light=min(scene.counts.z-1u,uint(sample_at(key,dim)*float(scene.counts.z)));
    Connection c=connect_light(s.point_delay.xyz,s.origin_time.w,s.spectral.x,light,
                               vec2(sample_at(key,dim+1),sample_at(key,dim+2)));
    if (!(c.pdf>0. && c.le>0.)) return;
    float cosine=volume?1.:dot(n,c.wi);
    vec2 b=volume?vec2(phase_at(dot(s.dir_beta.xyz,c.wi),g)):bsdf(m,s.spectral.x,n,wo,c.wi,ni,nt);
    if (!volume && (m.normal_info.x!=0u || m.normal_info.w!=0u)) b.x*=shading_factor(n,ns,c.wi);
    if (!(b.x>0.)) return;
    float weight=c.delta?1.:mis(c.pdf,b.y);
    float value=s.dir_beta.w*c.le*b.x*abs(cosine)*weight/c.pdf;
    if (!(value>0.)) return;
    vec3 origin=volume?s.point_delay.xyz:offset_surface(primitives[primitive],s.point_delay.xyz,n,c.wi);
    Shadow sh;
    sh.origin_dist=vec4(origin,c.dist);
    sh.dir_value=vec4(c.wi,value);
    sh.time_pulse=vec4(s.origin_time.w,s.point_delay.w,c.pulse);
    sh.point=vec4(s.point_delay.xyz,s.spectral.x);
    sh.endpoint=vec4(c.endpoint,0);
    sh.key=uvec4(key,cosine<0.?next:s.key.w,s.tracking.x-1u);
    for (uint i=0u;i<4u;++i) sh.boundary[i]=cosine<0.?next_stack[i]:s.boundary[i];
    shadows[slot]=sh;
    uint idx=atomicAdd(counter[2],1u);
    if (idx>=pc.count) fault(3u); else queue[2u*BATCH+idx]=slot;
}

void shade(uint slot) {
    State s=paths[slot];
    Hit h=hits[slot];
    float nm=s.spectral.x;
    bool nee=(pc.flags&1u)!=0u,volume=h.id.y!=0u;
    if (!volume && h.id.x==NONE) {
        if (scene.counts.w!=NONE) {
            Light l=lights[scene.counts.w];
            float base=spectrum(l.power,l.info.y,nm),le=environment_radiance(l,base,s.dir_beta.xyz);
            float p=l.pulse.z>0.?le/(environment_integral(l,base)*float(scene.counts.z)):
                1./(4.*PI*float(scene.counts.z));
            float w=nee && s.spectral.w==0.?mis(s.previous_pdf.w,p):1.;
            contribution(slot,0,s.dir_beta.w*w*le,-1.,l.pulse.xy);
        }
        return;
    }
    vec3 wo=-s.dir_beta.xyz,point=s.point_delay.xyz,n=vec3(0);
    float ni=index_at(s.boundary,s.key.w,nm,false),nt=ni,g=0.;
    uint next=s.key.w;
    uvec4 next_stack[4]=s.boundary;
    Material m;
    if (volume) {
        s.dir_beta.w*=h.normal_t.x;
        g=h.normal_t.y;
        m.info=uvec4(0);
    } else {
        Primitive p=primitives[h.id.x];
        m=materials[p.info.y];
        vec3 normal=h.normal_t.xyz;
        bool front=dot(wo,normal)>0.;
        n=front?normal:-normal;
        float le=front?spectrum(m.emission,m.info.z,nm):0.;
        if (le>0.) {
            float pdf=area_pdf(p,s.dir_beta.xyz,normal,length(point-s.previous_pdf.xyz));
            float w=nee && s.spectral.w==0.?mis(s.previous_pdf.w,pdf):1.;
            contribution(slot,0,s.dir_beta.w*w*le,s.point_delay.w,m.pulse.xy);
        }
        if (m.info.x==2u || m.info.x==4u) {
            if (!cross_at(next_stack,next,h.id.x,front)) return;
            nt=index_at(next_stack,next,nm,false);
        }
    }
    if (s.key.z>=pc.depth || s.dir_beta.w==0.) return;
    if (!volume && m.texture_info.x!=0u) {
        s.dir_beta.w*=texture_factor(m,primitives[h.id.x],h,nm);
        if (s.dir_beta.w==0.) return;
    }
    vec3 ns=n;
    if (!volume && (m.normal_info.x!=0u || m.normal_info.w!=0u)) {
        ns=shading_normal(m,primitives[h.id.x],h,n);
        s.dir_beta.w*=shading_factor(n,ns,wo);
        if (s.dir_beta.w==0.) return;
    }
    uint dim=6u+12u*s.key.z;
    if (nee) direct_light(slot,s,m,n,ns,wo,ni,nt,next_stack,next,dim,volume,g,h.id.x);
    vec3 u=vec3(sample_at(s.key.xy,dim+3),sample_at(s.key.xy,dim+4),sample_at(s.key.xy,dim+5));
    Scatter b;
    if (volume) {
        vec3 wi=phase_direction(s.dir_beta.xyz,g,u.xy);
        b=Scatter(wi,phase_at(dot(s.dir_beta.xyz,wi),g),1.,false,false);
    } else {
        b=scatter_at(m,nm,n,wo,ni,nt,u);
        if ((m.normal_info.x!=0u || m.normal_info.w!=0u)) b.weight*=shading_factor(n,ns,b.wi);
    }
    if (!(b.pdf>0. && b.weight>0.)) return;
    if (b.transmit) {
        s.key.w=next;
        s.boundary=next_stack;
        float ratio=nt/ni;
        s.spectral.z*=ratio*ratio;
    }
    s.dir_beta.w*=b.weight;
    if (!finite1(s.dir_beta.w)) { fault(7u); return; }
    if ((pc.flags&2u)!=0u && s.key.z>=3u) {
        float probability=clamp(s.dir_beta.w*s.spectral.y*s.spectral.z,.05,.95);
        if (sample_at(s.key.xy,dim+6)>=probability) return;
        s.dir_beta.w/=probability;
    }
    s.spectral.w=b.delta?1.:0.;
    s.previous_pdf=vec4(point,b.pdf);
    s.dir_beta.xyz=normalize(b.wi);
    s.origin_time.xyz=volume?point:offset_surface(primitives[h.id.x],point,n,s.dir_beta.xyz);
    ++s.key.z;
    paths[slot]=s;
    uint next_queue=1u-pc.parity;
    uint idx=atomicAdd(counter[next_queue],1u);
    if (idx>=pc.count) fault(8u); else queue[next_queue*BATCH+idx]=slot;
}

void shadow_path(uint slot) {
    Shadow s=shadows[slot];
    float tr=1.,nm=s.point.w,arrival=s.time_pulse.y;
    vec3 origin=s.origin_dist.xyz,d=s.dir_value.xyz,point=s.point.xyz;
    bool timed=s.origin_dist.w!=FAR;
    vec3 end=s.endpoint.xyz;
    for (uint i=0u;i<64u;++i) {
        vec3 toward=end-origin;
        float distance=timed?length(toward):FAR;
        if (distance==0.) { contribution(slot,1,s.dir_value.w*tr,arrival,s.time_pulse.zw); return; }
        vec3 direction=timed?toward/distance:d;
        float tolerance=timed?16e-7*(distance+length(origin)+length(end)):0.;
        Ray ray=Ray(origin,direction,0.,max(0.,distance-tolerance),s.time_pulse.x);
        Hit h=traverse(ray);
        atomicAdd(counter[4],1u);
        uint medium=medium_at(s.boundary,s.key.z);
        uint dim=0x80000000u+(64u*s.key.w+i)*TRACK_LIMIT;
        tr*=transmittance_at(media[medium],ray,h.id.x==NONE?distance:h.normal_t.w,nm,s.key.xy,dim);
        if (tr==0.) return;
        vec3 next=h.id.x==NONE?end:ray.o+ray.d*h.normal_t.w;
        if (timed) arrival+=length(next-point)*index_at(s.boundary,s.key.z,nm,true)/C_M_PER_NS;
        if (h.id.x==NONE) { contribution(slot,1,s.dir_value.w*tr,timed?arrival:-1.,s.time_pulse.zw); return; }
        Primitive p=primitives[h.id.x];
        if (materials[p.info.y].info.x!=3u) return;
        if (!cross_at(s.boundary,s.key.z,h.id.x,dot(d,h.normal_t.xyz)<0.)) return;
        next=surface_point(p,ray,h.normal_t);
        origin=offset_surface(p,next,h.normal_t.xyz,ray.d);
        point=next;
    }
    fault(13u);
}

void main() {
    uint idx=gl_GlobalInvocationID.x;
    if (pc.stage==0u) { if (idx<pc.count) generate(idx); return; }
    if (pc.stage==3u) {
        if (idx<min(counter[2],pc.count)) shadow_path(queue[2u*BATCH+idx]);
        return;
    }
    if (idx>=min(counter[pc.parity],pc.count)) return;
    uint slot=queue[pc.parity*BATCH+idx];
    if (pc.stage==1u) intersect_path(slot);
    else shade(slot);
}
