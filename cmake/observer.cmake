set(observer "${CMAKE_CURRENT_SOURCE_DIR}/data/CIE_xyz_1931_2deg.csv")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${observer}")
file(SHA256 "${observer}" observer_hash)
if(NOT observer_hash STREQUAL "fa663e3535a7e0763a745993a1f0a192eb0275ac46ad2d1befd7626841e713c1")
    message(FATAL_ERROR "CIE observer table checksum mismatch")
endif()
file(STRINGS "${observer}" rows)
set(table "/* Generated from the pinned CIE observer dataset. */\n")
foreach(row IN LISTS rows)
    string(REGEX REPLACE "^[0-9]+," "" values "${row}")
    string(APPEND table "{${values}},\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/observer.inc" CONTENT "${table}")
target_include_directories(vesper PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
